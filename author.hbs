{{!< default}} {{#author}} <div class="flex flex-col md:flex-row gap-10 md:mx-auto my-12 items-center w-full lg:w-264 ">


  {{#if profile_image}}

  <div class="group">
    <div class="size-34 overflow-hidden rounded-full border-4 border-white shadow-xl dark:border-slate-800">
      <img class="h-full w-full object-cover" src="{{profile_image}}" alt="{{name}}" fetchpriority="high" decoding="async" />
    </div>
  </div>

  {{else}}

  <div class="group">
    <div
      class="rounded-full  border border-gray-400 fill-white bg-gray-400 dark:fill-white dark:bg-gray-500 flex p-2 items-center justify-center">
      {{> "components/icon" name="circle-user-round" class="size-34" ariaLabel="circle user icon"}}
    </div>
  </div>

  {{/if}}

  <div class="flex flex-col w-full p-6 space-y-6">

    <h2 class="text-xl sm:text-xl md:text-2xl font-bold"> {{name}} </h2>

    {{#if bio}}
    <p class="text-md md:text-xl">{{bio}}</p>
    {{/if}}

    <div class="flex flex-wrap gap-5 justify-start">
      {{#social_accounts this}}
      <a href="{{href}}" target="_blank" rel="noopener noreferrer" aria-label="Visit our {{name}} profile"
        class="inline-flex items-center justify-center p-2 rounded-lg text-sm font-medium transition hover:opacity-75">
        {{#> (concat "icons/" type)}}
          {{> "icons/website"}}
        {{/undefined}}
        <span class="sr-only">Visit our {{name}} profile</span>
      </a>
      {{/social_accounts}}
    </div>

  </div>

  </div>

  <div class="container mx-auto mt-28 mb-20">
    <h1 class="text-3xl font-bold tracking-tight"> Published by {{name}}</h1>
  </div>

  {{/author}}

  {{> "posts-loop" posts=posts layout=@custom.home_layout}}

  <div class="container mx-auto px-6 py-10 lg:py-12 lg:px-8">
    {{pagination}}
  </div>