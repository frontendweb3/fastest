<header
    class="lg:sticky top-0 bg-background z-50 mx-auto w-full flex flex-col gap-10 lg:gap-0 lg:flex-row sm:px-6 sm:px-12 py-4 lg:py-6 items-center justify-between backdrop-blur">

    <a class="flex items-center gap-3 justify-center" href="{{@site.url}}">
        {{#if @site.logo}}
        <img class="block dark:hidden max-h-10 w-auto max-w-40 object-contain" src="{{@site.logo}}"
            alt="{{@site.title}}" loading="lazy" decoding="async" />
        {{/if}}

        {{#if @custom.logo_dark}}
        <img class="hidden dark:block max-h-10 w-auto max-w-40 object-contain" src="{{@custom.logo_dark}}"
            alt="{{@site.title}}" loading="lazy" decoding="async" />
        {{/if}}

        {{#if @custom.show_title_with_logo}}
        <span class="text-heading self-center text-lg font-semibold whitespace-nowrap">
            {{@site.title}}
        </span>
        {{/if}}
    </a>

    {{!-- Navigation --}}
    {{navigation}}

    {{!-- Social Links, theme toggle button and Search icon --}}
    <div class="justify-center flex flex-wrap items-center gap-5">

        {{!-- Search Form --}}
        <button data-ghost-search="true" id="search-toggle" type="button" aria-label="Toggle search"
            class="inline-flex items-center cursor-pointer justify-center size-8 rounded-lg p-2 text-sm font-medium transition hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-2">
            {{> "icons/search"}}
        </button>

        {{!-- Theme Toggle Button --}}
        <button x-data="themeSwitcher" @click="toggle" :aria-pressed="darkMode.toString()"
            :aria-label="darkMode ? 'Switch to light mode' : 'Switch to dark mode'" type="button"
            class="inline-flex justify-center items-center aspect-square whitespace-nowrap rounded-full p-2 text-sm font-medium tracking-wide transition hover:opacity-75 text-center focus-visible:outline-2 focus-visible:outline-offset-2 active:opacity-100 active:outline-offset-0 disabled:opacity-75 disabled:cursor-not-allowed">
            <span x-show="!darkMode" x-cloak aria-hidden="true"> {{> "components/icon" name="sun" class="size-4"
                ariaLabel="sun icon"}}</span>
            <span x-show="darkMode" x-cloak aria-hidden="true"> {{> "components/icon" name="moon" class="size-4"
                ariaLabel="moon icon"}}</span>
            <span class="sr-only">Toggle color theme</span>
        </button>

        {{#social_accounts @site}}
        <a href="{{href}}" target="_blank" rel="noopener noreferrer" aria-label="Visit our {{name}} profile"
            class="inline-flex items-center justify-center p-2 rounded-lg text-sm font-medium transition hover:opacity-75">
            {{#> (concat "icons/" type)}}
            {{> "icons/website"}}
            {{/undefined}}
        </a>
        {{/social_accounts}}

        <div class="hidden sm:block h-5 rounded-3xl w-0.5 bg-black dark:bg-white"></div>

        {{#unless @member}}
        <a class="group flex items-center gap-2 shadow-lg rounded-full px-4 py-2 text-sm font-medium text-white transition-transform hover:scale-105"
            style="background-color:{{@site.accent_color}}" href="#/portal/signin" data-portal="signin"
            aria-label="Sign in">
            {{> "components/icon" name="log-in" class="size-4 text-white transition-transform duration-300
            group-hover:translate-x-1" ariaLabel="Sign in icon"}}
            <span class="text-white">Sign in</span>
        </a>
        <a class="group flex items-center gap-2 shadow-lg rounded-full px-4 py-2 text-sm font-medium text-white transition-transform hover:scale-105"
            style="background-color:{{@site.accent_color}}" href="#/portal/signup" data-portal="signup"
            aria-label="Sign up">
            {{> "components/icon" name="user-plus" class="size-4 text-white transition-transform duration-300
            group-hover:scale-110 group-hover:-rotate-12" ariaLabel="Sign up icon"}}
            <span class="text-white">Sign up</span>
        </a>
        {{else}}
        <a style="background-color:{{@site.accent_color}}" href="#/portal/account" aria-label="Open your account page"
            class="group flex items-center gap-2 shadow-lg text-white rounded-full xl:px-3.5 xl:py-2 transition-transform hover:scale-105">
            {{#if @member.avatar_image}}
            <img class="h-8 w-8 rounded-full object-cover transition-transform duration-300 group-hover:scale-105"
                src="{{@member.avatar_image}}" alt="{{@member.name}} avatar" decoding="async" />
            {{else}}
            {{> "components/icon" name="user-round" class="size-5 text-white p-0.5 transition-transform duration-300
            group-hover:scale-110" ariaLabel="User icon"}}
            {{/if}}
            <span class="hidden xl:inline text-white font-medium pr-1 xl:pr-0">{{@member.name}}</span>
        </a>
        {{/unless}}

    </div>

</header>