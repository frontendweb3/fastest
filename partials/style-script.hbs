<link rel="stylesheet" href="{{asset 'dist/css/main.css'}}" />
<script type="module" defer src="{{asset 'dist/js/main.js'}}"></script>

{{#is "post, page"}}
    {{!-- Highlight code and config the copy code button on code block --}}
    <script type="module" defer src="{{asset "dist/js/post.js"}}"></script>
    <link rel="stylesheet" href="{{asset 'dist/css/post.css'}}" />
{{/is}}

<style>

    body :where(:not(h1, h2, h3, h4, h5, h6)) {
        font-family: var(--font-body);
    }

    body :where(h1, h2, h3, h4, h5, h6) {
        font-family: var(--font-heading);
        font-weight: 700;
    }

    :root {
        --background: {{#if @custom.background_color_for_light_mode}} {{@custom.background_color_for_light_mode}} {{else}} oklch(1 0 0) {{/if}};
        --foreground: {{#if @custom.font_color_for_light_mode}}{{@custom.font_color_for_light_mode}}{{else}} oklch(0.141 0.005 285.823) {{/if}};
        --color-background: var(--background);
        --color-foreground: var(--foreground);
        --prose-color: var(--foreground);
        --font-heading: var(--gh-font-heading), Arial, ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
        --font-body: var(--gh-font-body), Helvetica, ui-sans, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";

    }

    .dark {
        --background: {{#if @custom.background_color_for_dark_mode}}{{@custom.background_color_for_dark_mode}}{{else}} oklch(0.141 0.005 285.823) {{/if}};
        --foreground: {{#if @custom.font_color_for_dark_mode}}{{@custom.font_color_for_dark_mode}}{{else}} oklch(0.985 0 0) {{/if}};
        --color-background: var(--background);
        --color-foreground: var(--foreground);
        --prose-color: var(--foreground);
        --font-heading: var(--gh-font-heading), Arial, ui-sans-serif, ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
        --font-body: var(--gh-font-body), Helvetica, ui-sans-serif, ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
    }
</style>

