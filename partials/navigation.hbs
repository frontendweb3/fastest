{{#if isSecondary}}
  <nav aria-label="Secondary navigation">
        <ul class="list-none flex flex-wrap gap-x-5 gap-y-3 justify-center flex-row items-center">
            {{#foreach navigation}}
    
                <li class="text-left group">
                    <a href="{{url absolute="true"}}" 
                        {{#if current}}aria-current="page"{{/if}}
                        class="inline-block px-2 md:px-3 lg:px-6 py-2 text-sm border-b-2 group-hover:border-blue-600 transition-colors duration-300 {{#if current}}border-blue-600 font-semibold nav-current{{else}}border-transparent{{/if}}">
                         {{label}} 
                    </a>
                </li>

            {{/foreach}}
                
            </ul>
        </nav>

{{else}}

  <nav aria-label="Main navigation">
        <ul class="list-none flex justify-center flex-wrap gap-x-4 gap-y-3 sm:gap-x-6 items-center">

            {{#foreach navigation}}

                <li class="text-center group">
                    <a href="{{url absolute="true"}}" 
                        {{#if current}}aria-current="page"{{/if}}
                        class="inline-block px-2 md:px-3 lg:px-6 py-2 text-sm md:text-base border-b-2 group-hover:border-blue-600 transition-colors duration-300 {{#if current}}border-blue-600 font-semibold nav-current{{else}}border-transparent{{/if}}">
                         {{label}} 
                    </a>
                </li>

            {{/foreach}}
                
            </ul>
    </nav>

{{/if}}