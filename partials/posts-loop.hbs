{{!-- Reusable wrapper for rendering post cards in grid or stacked layout. --}}
{{#if posts.length}}
{{#match layout "three-column-grid"}}
<div class="sm:container mx-auto md:px-6 py-10 lg:py-12 lg:px-8">
    <div class="grid gap-8 p-5 lg:gap-12 md:grid-cols-2 lg:grid-cols-3">
        {{#foreach posts}}
        {{> "cards/card" }}
        {{/foreach}}
    </div>
</div>
{{else match layout "two-column-grid"}}
<div class="sm:container mx-auto md:px-6 py-10 lg:py-12 lg:px-8">
    <div class="grid gap-8 p-5 lg:gap-12 md:grid-cols-2">
        {{#foreach posts}}
        {{> "cards/card" }}
        {{/foreach}}
    </div>
</div>
{{else}}
<div class="sm:container mx-auto px-6 py-10 space-y-12 md:space-y-28 lg:py-12 lg:px-8">
    {{#foreach posts}}
    {{> "cards/card" }}
    {{/foreach}}
</div>
{{/match}}
{{/if}}