<article
  class="relative group mx-auto w-full bg-card/80 text-card-foreground md:mx-auto flex flex-col rounded-xl shadow-lg overflow-hidden transition-transform duration-300 ease-in-out hover:scale-[1.02]">

  {{!-- Clickable Overlay Link --}}
  <a href="{{url}}" class="absolute inset-0 z-10" aria-label="{{title}}">
    <span class="sr-only">{{title}}</span>
  </a>

  {{#if feature_image}}
  <div class="relative w-full h-60 sm:h-72 overflow-hidden shrink-0">
    <img srcset="{{img_url feature_image size='s'}} 300w, {{img_url feature_image size='m' }} 600w, {{img_url
      feature_image size='l' }} 1000w, {{img_url feature_image size='xl' }} 2000w"
      sizes="(max-width: 1000px) 400px, 700px" src="{{img_url feature_image size='m'}}"
      class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110"
      alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
  </div>
  {{/if}}

  <div class="p-6 lg:p-8 flex flex-col flex-1 justify-start">

    <div class="flex mt-2 flex-row justify-between">

      {{#if primary_tag}}
      <p
        class="relative z-20 hover:underline-offset-4 inline-flex items-center gap-2 px-2.5 py-1 text-base font-bold text-center uppercase align-middle animate-in fade-in duration-500 ease-in-out">
        {{> "components/icon" name="tag" class="size-4 group-hover:animate-in group-hover:fade-in
        group-hover:-translate-x-1 group-hover:duration-500 group-hover:ease-in-out transition-transform"
        ariaLabel="tag icon"}}
        {{primary_tag.name}}
      </p>
      {{/if}}

      {{#unless access}}
      {{#has visibility="members"}}
      <h6 class="flex items-center gap-2 text-base antialiased font-semibold leading-relaxed tracking-normal uppercase">
        {{> "components/icon" name="lock" class="size-4" ariaLabel="Lock icon"}}
        Members only
      </h6>
      {{else}}
      <h6 class="flex items-center gap-2 text-base antialiased font-semibold leading-relaxed tracking-normal uppercase">
        {{> "components/icon" name="user-plus" class="size-4" ariaLabel="User Plus icon"}}
        Paid Members only
      </h6>
      {{/has}}
      {{/unless}}

    </div>

    <div class="flex mt-5 flex-col">
      <h2 class="mb-2 text-2xl antialiased font-semibold leading-snug tracking-normal">
        {{title}}
      </h2>
    </div>

    <div class="flex mt-5 flex-row justify-between items-center">

      {{!-- author --}}
      <div class="hidden sm:flex items-center space-x-4">

        {{#if primary_author.profile_image}}
        <img src="{{img_url primary_author.profile_image size=" s"}}" alt="{{primary_author.name}}"
          class="w-6 h-6 object-cover rounded-full" />
        {{/if}}

        <div class="flex flex-col justify-center items-center">
          <a class="relative z-20 w-full text-sm font-medium hover:underline" href="{{primary_author.url}}">
            {{primary_author.name}}
          </a>
        </div>

      </div>

      {{!-- author for small --}}
      <a class="relative z-20 block sm:hidden text-sm font-medium hover:underline" href="{{primary_author.url}}">
        {{primary_author.name}}
      </a>

      <span
        class="relative z-20 flex items-center gap-2 px-2.5 py-1 text-xs group-hover:underline underline-offset-4 font-bold text-center uppercase align-middle animate-in fade-in duration-500 ease-in-out pointer-events-none">
        Read More
        {{> "components/icon" name="arrow-right" class="size-4 group-hover:animate-in group-hover:fade-in
        group-hover:translate-x-1 group-hover:duration-500 group-hover:ease-in-out transition-transform"}}
      </span>

    </div>

  </div>

</article>