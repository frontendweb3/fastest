<article class="group mx-auto w-full m-10 bg-card text-card-foreground md:mx-auto flex flex-col rounded-xl shadow-md transition-transform duration-300 ease-in-out hover:scale-[1.02]">
    
    <div class="rounded-none h-60 lg:h-70 col-span-2 justify-self-auto relative m-0 overflow-hidden lg:rounded-xl shrink-0">
      {{#if feature_image}}
        <img
          srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
          sizes="(max-width: 1000px) 400px, 700px"
          src="{{img_url feature_image size="m"}}"
          class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-120"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
      {{/if}}

    </div>

    <div class="p-6 lg:p-8 col-span-2 flex flex-col justify-center lg:col-start-3 lg:col-end-5 ">

      <div class="flex mt-2 flex-row justify-between">

      {{#if primary_tag}}      
        <a href="{{primary_tag.url}}" class="group no-underline hover:underline hover:underline-offset-4 inline-flex items-center gap-2 px-2.5 py-1 text-base font-bold text-center uppercase align-middle animate-in fade-in duration-500 ease-in-out">
          {{> "components/icon" name="tag" class="size-4 group-hover:animate-in group-hover:fade-in group-hover:-translate-x-1 group-hover:duration-500 group-hover:ease-in-out transition-transform" ariaLabel="tag icon"}}
          {{primary_tag.name}}
        </a>
      {{/if}}

      {{#unless access}}

        {{#has visibility="members"}}
            <h6 class="mb-4 flex items-center gap-2 text-base antialiased font-semibold leading-relaxed tracking-normal uppercase">
              {{> "components/icon" name="lock" ariaLabel="Lock icon"}}
              Members only
            </h6>
        {{else}}
            <h6 class="mb-4 flex items-center gap-2 text-base antialiased font-semibold leading-relaxed tracking-normal uppercase">
              {{> "components/icon" name='user-plus' ariaLabel="User Plus icon"}}
              Paid Members only
            </h6>
        {{/has}}

      {{/unless}}

      </div>

      <div class="flex mt-5 flex-col">
        <h2 class="mb-2 text-2xl antialiased font-semibold leading-snug tracking-normal">
          {{title}}
        </h2>
      </div>

      <div class="flex mt-5 flex-row justify-between items-center">

        {{!-- author --}}
        <div class="hidden sm:flex items-center space-x-4">

          {{#if primary_author.profile_image}}
              <img src="{{img_url primary_author.profile_image size="s"}}" alt="{{primary_author.name}}"
                class="w-6 h-6 rounded-full " />
          {{/if}}          
          
          <div class="flex flex-col justify-center items-center">
            <a class="w-full text-sm font-medium" href="{{primary_author.url}}">
              {{primary_author.name}}
            </a>
          </div>

        </div>

        {{!-- author for small --}}
        <a class="block sm:hidden text-sm font-medium" href="{{primary_author.url}}">
          {{primary_author.name}}
        </a>
       
        <a href="{{url}}" aria-label="Click here to read full article" class="group flex items-center gap-2 px-2.5 py-1 text-xs hover:underline underline-offset-4 font-bold text-center uppercase align-middle animate-in fade-in duration-500 ease-in-out">

        Read More

        {{> "components/icon" name="arrow-right" class="group-hover:animate-in group-hover:fade-in group-hover:translate-x-1 group-hover:duration-500 group-hover:ease-in-out transition-transform"}} {{!-- partials/icons/arrow.hbs --}}

      </a>

      </div>

    </div>

</article>