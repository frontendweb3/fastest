<article
    class="group relative flex w-full max-w-307 mx-auto flex-col lg:max-h-124 overflow-hidden rounded-xl bg-card shadow-[0_24px_70px_rgba(0,0,0,0.28)] transition-transform duration-500 hover:-translate-y-1 lg:flex-row">

    {{!-- Clickable Overlay Link --}}
    <a href="{{url}}" class="absolute inset-0 z-10" aria-label="{{title}}">
        <span class="sr-only">{{title}}</span>
    </a>

    {{#if feature_image}}
    <div class="relative shrink-0 overflow-hidden lg:w-1/2">
        <img srcset="{{img_url feature_image size='s'}} 300w, {{img_url feature_image size='m'}} 600w, {{img_url
            feature_image size='l'}} 1000w, {{img_url feature_image size='xl'}} 2000w"
            sizes="(max-width: 1000px) 400px, 700px" src="{{img_url feature_image size='m'}}"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
    </div>
    {{/if}}

    <div class="flex min-h-111.25 flex-1 flex-col p-7 sm:p-9 lg:p-10">
        <div
            class="flex items-center justify-between gap-4 text-xs font-bold uppercase tracking-tight text-card-foreground sm:text-sm">
            <span class="group flex items-center gap-2">
                {{> "components/icon" name="tag" class="size-4 group-hover:animate-in group-hover:fade-in
                group-hover:-translate-x-1 group-hover:duration-500 group-hover:ease-in-out
                transition-transform"
                ariaLabel="tag icon"}}
                {{primary_tag.name}}
            </span>
            {{#unless access}}
            {{#has visibility="members"}}
            <span class="flex items-center gap-2 whitespace-nowrap">
                {{> "components/icon" name="user-plus" class="size-4 group-hover:animate-in group-hover:fade-in
                group-hover:duration-1000 group-hover:ease-in-out
                transition-transform"
                ariaLabel="User Plus icon"}}
                Members only
            </span>
            {{else}}
            <span class="flex items-center gap-2 whitespace-nowrap">
                {{> "components/icon" name="lock" class="size-4 group-hover:animate-in group-hover:fade-in
                group-hover:duration-500 group-hover:ease-in-out
                transition-transform"
                ariaLabel="Lock icon"}}
                Paid Members only
            </span>
            {{/has}}
            {{/unless}}


        </div>

        <div class="flex flex-1 flex-col justify-center py-9 sm:py-8">
            <h1
                class="max-w-150 text-balance text-3xl font-bold leading-[1.2] tracking-[-0.035em] text-card-foreground sm:text-4xl lg:text-[36px]">
                {{title}}</h1>
            <p class="mt-5 max-w-145 text-pretty text-[15px] leading-6 text-muted-foreground sm:text-base">
                {{excerpt}}</p>
        </div>

        <div class="flex items-end justify-between gap-5">
            <div class="flex items-center gap-3">
                <div
                    class="hidden sm:flex size-10 items-center justify-center rounded-full bg-accent text-sm font-bold text-accent-foreground ring-2 ring-card-foreground/10">
                    {{#if primary_author.profile_image}}
                    <img src="{{img_url primary_author.profile_image size='s'}}" alt="{{primary_author.name}}"
                        class="w-10 h-10 object-cover rounded-full" />
                    {{/if}}

                </div>

                <div>
                    <p class="text-sm font-bold text-card-foreground">{{primary_author.name}}</p>
                    <time datetime="{{date format='YYYY-MM-DD'}}" class="mt-1 text-xs text-muted-foreground"> {{date
                        format="DD MMMM YYYY"}} </time>
                </div>
            </div>
            <a href="{{url}}"
                class="group flex items-center gap-2 pb-1 text-xs font-bold uppercase tracking-wide text-card-foreground transition-colors hover:text-muted-foreground"
                aria-label="Read more: {{title}}"> Read more
                {{> "components/icon" name="arrow-right" class="size-4 hidden sm:inline-block group-hover:animate-in
                group-hover:fade-in group-hover:translate-x-1 group-hover:duration-500 group-hover:ease-in-out
                transition-transform"}}

            </a>
        </div>
    </div>
</article>