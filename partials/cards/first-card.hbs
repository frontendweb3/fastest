<article
  class="relative group mx-auto w-full lg:w-6/6 xl:w-5/6 text-card-foreground md:mx-auto grid rounded-xl shadow-lg grid-cols-1 lg:grid-cols-4 overflow-hidden">

  {{!-- Clickable Overlay Link --}}
  <a href="{{url}}" class="absolute inset-0 z-10" aria-label="{{title}}">
    <span class="sr-only">{{title}}</span>
  </a>

  {{#if feature_image}}
  <div class="col-span-1 lg:col-span-2 relative w-full h-64 sm:h-80 lg:h-full lg:min-h-full overflow-hidden shrink-0">
    <img srcset="{{img_url feature_image size=" s"}} 300w, {{img_url feature_image size="m" }} 600w, {{img_url
      feature_image size="l" }} 1000w, {{img_url feature_image size="xl" }} 2000w"
      sizes="(max-width: 1000px) 400px, 700px" src="{{img_url feature_image size=" m"}}"
      class="absolute inset-0 object-cover w-full h-full transition-transform duration-500 group-hover:scale-110"
      alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
  </div>
  {{/if}}

  <div class="p-6 lg:p-8 col-span-1 lg:col-span-2 flex flex-col justify-between h-full">

    <div class="flex mt-2 flex-row justify-between">

      {{#if primary_tag}}
      <a href="{{primary_tag.url}}"
        class="relative z-20 group/tag no-underline hover:underline hover:underline-offset-4 flex items-center gap-2 px-2.5 py-1 text-base font-bold text-center uppercase align-middle animate-in fade-in duration-500 ease-in-out">
        {{> "components/icon" name="tag" class="size-4 group-hover/tag:animate-in group-hover/tag:fade-in
        group-hover/tag:-translate-x-1 group-hover/tag:duration-500 group-hover/tag:ease-in-out transition-transform"
        ariaLabel="tag icon"}}
        {{primary_tag.name}}
      </a>
      {{/if}}

      {{#unless access}}
      {{#has visibility="members"}}
      <h6 class="flex items-center gap-2 text-base antialiased font-semibold leading-relaxed tracking-normal uppercase">
        {{> "components/icon" name="lock" class="size-4" ariaLabel="Lock icon"}}
        Members only
      </h6>
      {{else}}
      <h6 class="flex items-center gap-2 text-base antialiased font-semibold leading-relaxed tracking-normal uppercase">
        {{> "components/icon" name="user-plus" class="size-4" ariaLabel="User Plus icon"}}
        Paid Members only
      </h6>
      {{/has}}
      {{/unless}}

    </div>

    <div class="flex mt-5 flex-col">
      <h2
        class="mb-2 text-2xl md:text-3xl lg:text-4xl antialiased font-semibold leading-snug tracking-normal group-hover:underline">
        {{title}}
      </h2>

      <p class="mb-10 text-base antialiased font-normal leading-relaxed">
        {{excerpt characters="100"}}
      </p>
    </div>

    <div class="flex flex-row justify-between items-center">

      {{!-- author --}}
      <div class="hidden sm:flex items-center space-x-4">

        {{#if primary_author.profile_image}}
        <img src="{{img_url primary_author.profile_image size=" s"}}" alt="{{primary_author.name}}"
          class="w-10 h-10 rounded-full" />
        {{/if}}

        <div class="flex flex-col justify-start items-start gap-1.5">

          <a class="relative z-20 w-full" href="{{primary_author.url}}">
            <h3 class="text-sm font-medium hover:underline">{{primary_author.name}}</h3>
          </a>

          <time datetime="{{date format='YYYY-MM-DD'}}" class="text-sm">
            {{date format="DD MMMM YYYY"}}
          </time>

        </div>

      </div>

      {{!-- author for small --}}
      <a class="relative z-20 block sm:hidden text-sm font-medium hover:underline" href="{{primary_author.url}}">
        {{primary_author.name}}
      </a>

      <span
        class="relative z-20 flex items-center gap-2 px-2.5 py-1 text-xs group-hover:underline underline-offset-4 font-bold text-center uppercase align-middle animate-in fade-in duration-500 ease-in-out pointer-events-none">
        Read More
        {{> "components/icon" name="arrow-right" class="size-4 group-hover:animate-in group-hover:fade-in
        group-hover:translate-x-1 group-hover:duration-500 group-hover:ease-in-out transition-transform"}}
      </span>

    </div>

  </div>

</article>