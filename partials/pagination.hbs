<nav role="navigation" aria-label="Pagination" class="container mx-auto my-16 px-4 flex items-center">
    {{#if prev}}
    <a class="flex gap-2 h-16 w-28 items-center justify-center rounded-full text-md text-foreground transition-transform hover:scale-105"
        href="{{page_url prev}}" aria-label="Previous page">
        {{> "components/icon" name="chevron-left" class="size-4" ariaLabel="Chevron Left icon"}} Previous<span class="sr-only"> page</span>
    </a>
    {{/if}}

    {{#if next}}
    <a class="ml-auto gap-2 flex h-16 w-28 items-center justify-center rounded-full animate-in text-md text-foreground transition-transform hover:scale-105"
        href="{{page_url next}}" aria-label="Next page">
        Next<span class="sr-only"> page</span>
        {{> "components/icon" name="chevron-right" class="size-4" ariaLabel="Chevron Right icon"}}
    </a>
    {{/if}}
</nav>